---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getOgImageUrl } from '../lib/cloudinary';
import Observatory from '../components/Observatory.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.publishDate.getTime() - a.data.publishDate.getTime()
  )
  .slice(0, 3);

// OG image for the home page — use the most recent post's cover, or a known sample
const ogImage = allPosts.length > 0
  ? getOgImageUrl(allPosts[0].data.coverImage, { cloudName: allPosts[0].data.coverCloudName })
  : getOgImageUrl('cld-sample-2', { cloudName: 'demo' });

---
<Layout title="Paul Applegate — A Cabinet of Curiosities" description="Science, small experiments, and the pleasure of figuring things out. A personal cabinet of curiosities by Paul Applegate." ogImage={ogImage}>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <p class="eyebrow"><span aria-hidden="true"><!-- Draw the asterisk so mobile devices cannot substitute a color emoji. --><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" focusable="false" style="vertical-align: -0.125em"><path d="M12 2v20M2 12h20M5 5l14 14M5 19L19 5" /></svg></span> A PERSONAL CORNER OF THE INTERNET</p>
        <h1>Stay curious.<br/>Look <em>closer.</em></h1>
        <p class="intro">There’s a whole universe hiding in the details. A place for science, beautiful images, and the quiet pleasure of figuring things out. Explorers need help to, so I thank <a href="https://github.com/musebe/cloudinary-media-portfolio.git" target="_blank" rel="noopener">Eugene Musebe</a> for his template. A quick F.Y.I., if you use Safari you can view every image as a jxl formatted image. Other browsers need to enable it using these simple <a href="/jxlsetup">instructions</a>.</p>
        <a class="explore" href="#field-notes">Open the cabinet <span aria-hidden="true">↘</span></a>
        <p class="small-note">Made by Paul. Best explored slowly.</p>
      </div>
      <div class="hero-media">
        <div class="mosaic">
          <CloudinaryImage
            publicId="cld-sample-2" cloudName="demo"
            alt="Mountain landscape" width={800} height={700}
            sizes="(max-width: 768px) calc(58vw - 2.03rem), (max-width: 1248px) calc(29vw - 2.32rem), 325px"
            crop="fill" gravity="auto" loading="eager" fetchpriority="high"
            pictureClass="mosaic-a"
          />
          <CloudinaryImage
            publicId="cld-sample-4" cloudName="demo"
            alt="Cloudinary sample photo in grayscale" width={500} height={330}
            sizes="(max-width: 768px) calc(42vw - 1.47rem), (max-width: 1248px) calc(21vw - 1.68rem), 235px"
            crop="fill" gravity="auto" grayscale loading="eager"
            pictureClass="mosaic-b"
          />
          <CloudinaryImage
            publicId="cld-sample-3" cloudName="demo"
            alt="Cloudinary sample photo" width={500} height={330}
            sizes="(max-width: 768px) calc(42vw - 1.47rem), (max-width: 1248px) calc(21vw - 1.68rem), 235px"
            crop="fill" gravity="auto" loading="eager"
            pictureClass="mosaic-c"
          />
        </div>
        <div class="image-caption"><span>01 — A FEW DIFFERENT WAYS OF SEEING</span><span>JXL → AVIF → WebP</span></div>
      </div>
    </div>
  </section>
  <section id="field-notes" class="recent container" aria-labelledby="notes-title">
    <div class="section-head"><div><p class="eyebrow">FROM THE WORKBENCH</p><h2 id="notes-title">Three things to open.</h2></div><a href="/blog">All field notes <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">Little experiments in making the web a more beautiful place. Pick a card and take a closer look.</p>
    <div class="posts-grid">{recentPosts.map(post => <BlogCard post={post} />)}</div>
  </section>
  <Observatory />
  <section class="closing container" aria-labelledby="closing-title"><p class="eyebrow">AN OPEN-ENDED COLLECTION</p><h2 id="closing-title">The best part of learning?<br/><em>There’s always another question.</em></h2><p>This corner of the web has room for both careful engineering and a little wonder. Thanks for stopping by.</p></section>
</Layout>
<style>
.container{max-width:var(--max-width);margin:0 auto}.hero{padding:4.5rem 1.5rem 4rem;border-bottom:1px solid var(--border);overflow:hidden}.hero-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4rem;align-items:center}.eyebrow{font-size:.66rem;font-weight:600;letter-spacing:.16em;color:var(--text-muted)}.eyebrow span{color:var(--accent);font-size:1.2rem;margin-right:.5rem}h1{font-size:clamp(3.5rem,6vw,5.5rem);line-height:1.04;letter-spacing:-.065em;margin:1.7rem 0}h1 em{font-weight:400;color:var(--accent)}.intro{max-width:40ch;color:var(--text-muted);font-size:1.04rem;line-height:1.8}.explore{display:inline-flex;gap:2rem;align-items:center;background:var(--text);color:var(--bg);padding:.9rem 1.25rem;margin:1.8rem 0 1.2rem;font-size:.8rem;text-decoration:none;border-radius:3px}.explore:hover{background:var(--accent)}.explore span{font-size:1.2rem}.small-note{font-size:.7rem;color:var(--text-muted)}
.hero-media{display:flex;flex-direction:column;gap:.9rem}.mosaic{display:grid;grid-template-columns:minmax(0,58fr) minmax(0,42fr);grid-template-rows:1fr 1fr;gap:8px;height:460px;border-radius:110px 8px 8px 8px;overflow:hidden}.mosaic :global(.mosaic-a){grid-row:1 / 3;width:100%;height:100%;object-fit:cover;display:block}.mosaic :global(.mosaic-b),.mosaic :global(.mosaic-c),.mosaic :global(img){width:100%;height:100%;object-fit:cover;display:block}.image-caption{display:flex;justify-content:space-between;gap:1rem;font-size:.53rem;letter-spacing:.08em;color:var(--text-muted)}
.recent{padding:4.5rem 1.5rem 5rem}.section-head{display:flex;align-items:end;justify-content:space-between;gap:1.5rem}.section-head h2{font-size:clamp(1.8rem,3vw,2.6rem);font-weight:500;margin-top:.7rem;letter-spacing:-.045em}.section-head>a{font-size:.8rem;color:var(--text);white-space:nowrap;text-underline-offset:5px}.section-intro{font-size:.9rem;color:var(--text-muted);margin:1rem 0 2rem}.posts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:2rem}
.closing{padding:5rem 1.5rem;text-align:center}.closing h2{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:500;margin:1.5rem 0;line-height:1.3}.closing h2 em{font-weight:400;color:var(--accent)}.closing>p:not(.eyebrow){font-size:.9rem;max-width:53ch;margin:auto;color:var(--text-muted)}.signature{display:block;font-style:italic;font-size:1.4rem;margin-top:1.4rem}
@media(max-width:768px){.hero{padding:2.5rem 1.5rem 3rem}.hero-inner{grid-template-columns:1fr;gap:2.5rem}.mosaic{height:300px}.image-caption{font-size:.48rem}.recent{padding-top:3rem}.section-head{align-items:start}.section-head>a{padding-top:.2rem}.closing{padding:3.5rem 1.5rem}}
@media(max-width:360px){.posts-grid{grid-template-columns:minmax(0,1fr)}.section-head{flex-direction:column}}
</style>
