---
import Layout from './Layout.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';
import CloudinaryShowcase from '../components/CloudinaryShowcase.astro';
import { getOgImageUrl } from '../lib/cloudinary';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate, coverImage, coverCloudName, coverAlt, tags, author } = post.data;

const date = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const ogImage = getOgImageUrl(coverImage, { cloudName: coverCloudName });
---

<Layout title={`${title} | CloudAstro`} description={description} ogImage={ogImage}>
  <article>

    <!--
      Hero concept: two versions of the same Cloudinary image.
        Background — blurred via e_blur:2000, cropped, slightly zoomed.
        Foreground — sharp, contained in a floating card with dramatic shadow.
      The title, tags, and meta live below the card in white text.
      Result: cinematic, on-brand, and directly demonstrates Cloudinary in the UI.
    -->
    <section class="hero" aria-label="Post hero">

      <!-- Blurred Cloudinary image as full-bleed background -->
      <div class="bg" aria-hidden="true">
        <CloudinaryImage
          publicId={coverImage}
          cloudName={coverCloudName}
          crop="fill"
          gravity="auto"
          blur={2000}
          sizes="100vw"
          alt=""
          width={1440}
          height={760}
          loading="eager"
        />
        <div class="bg-overlay"></div>
      </div>

      <!-- Floating card + post header -->
      <div class="hero-inner">

        <!-- Sharp image in a floating card -->
        <div class="photo-card">
          <CloudinaryImage
            publicId={coverImage}
            cloudName={coverCloudName}
            alt={coverAlt}
            width={880}
            height={495}
            sizes="(max-width: 928px) calc(100vw - 3rem), 880px"
            crop="fill"
            gravity="auto"
            loading="eager"
            fetchpriority="high"
            class="photo"
          />
          <!-- Subtle shimmer on the card edge -->
          <div class="card-shine" aria-hidden="true"></div>
        </div>

        <!-- Post header: tags, title, meta — white on the dark blur bg -->
        <header class="post-header">
          <div class="tags" role="list">
            {tags.map(tag => (
              <span class="tag" role="listitem">{tag}</span>
            ))}
          </div>
          <h1>{title}</h1>
          <div class="meta">
            <span class="author">{author}</span>
            <span class="dot" aria-hidden="true">·</span>
            <time datetime={publishDate.toISOString()}>{date}</time>
          </div>
        </header>

      </div>
    </section>

    <!-- Cloudinary showcase — wider than prose for visual impact -->
    <div class="showcase-wrap">
      <CloudinaryShowcase cloudName={coverCloudName} publicId={coverImage} alt={coverAlt} />
    </div>

    <!-- Article prose -->
    <div class="prose-wrap">
      <div class="prose">
        <slot />
      </div>
      <footer class="post-footer">
        <a href="/blog" class="back" aria-label="Back to all posts">&larr; Back to all posts</a>
      </footer>
    </div>

  </article>
</Layout>

<style>
  article {
    width: 100%;
  }

  /* ── Hero ────────────────────────────────────────────────── */

  .hero {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 1.5rem 4rem;
  }

  /* Full-bleed blurred Cloudinary image */
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .bg :global(picture) { height: 100%; }

  .bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Extra CSS blur smooths any compression artifacts at the edges */
    filter: blur(4px) scale(1.04);
  }

  /* Deep purple-tinted dark overlay — creates depth and ensures readability */
  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      rgb(5 2 18 / 0.88) 0%,
      rgb(28 12 55 / 0.84) 50%,
      rgb(10 5 30 / 0.90) 100%
    );
  }

  /* Centered content layer */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
  }

  /* Floating sharp image card */
  .photo-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.07),
      0 8px 24px  rgb(0 0 0 / 0.45),
      0 32px 64px  rgb(0 0 0 / 0.4),
      0 64px 120px rgb(0 0 0 / 0.25);
  }

  :global(.photo) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Glass-like shimmer on the top edge of the card */
  .card-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.06) 0%,
      transparent 40%
    );
    pointer-events: none;
  }

  /* Post header — white text on the blurred dark background */
  .post-header {
    padding: 0 0.25rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.125rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
  }

  .post-header h1 {
    font-size: clamp(1.875rem, 4.5vw, 3.25rem);
    color: white;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.3);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.55);
  }

  .author {
    color: rgb(255 255 255 / 0.78);
    font-weight: 500;
  }

  .dot {
    opacity: 0.3;
  }

  /* ── Showcase ──────────────────────────────────────────────── */

  .showcase-wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Prose ─────────────────────────────────────────────────── */

  .prose-wrap {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.625rem;
    margin-top: 3rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 2.25rem;
    margin-bottom: 0.625rem;
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: 0.375rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
  }

  .prose :global(th) {
    background: var(--bg-secondary);
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
  }

  .prose :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    border-radius: var(--radius-md);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* ── Footer ─────────────────────────────────────────────────── */

  .post-footer {
    margin-top: 4rem;
    padding: 2rem 0 5rem;
    border-top: 1px solid var(--border);
  }

  .back {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }
</style>
