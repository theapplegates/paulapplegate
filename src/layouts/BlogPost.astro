---
import Layout from './Layout.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';
import CloudinaryShowcase from '../components/CloudinaryShowcase.astro';
import { getImageUrl } from '../lib/cloudinary';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate, coverImage, coverAlt, tags, author } = post.data;

const date = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// OG image at 1200×630 — generated by Cloudinary at build time, no Figma needed
const ogImage = getImageUrl(coverImage, { width: 1200, height: 630, crop: 'fill' });
---

<Layout title={`${title} | CloudCanvas`} description={description} ogImage={ogImage}>
  <article>

    <!-- ── Full-bleed hero ───────────────────────────────────── -->
    <div class="hero">
      <CloudinaryImage
        publicId={coverImage}
        alt={coverAlt}
        width={1440}
        height={600}
        widths={[768, 1024, 1440, 1920]}
        sizes="100vw"
        crop="fill"
        gravity="auto"
        loading="eager"
        class="hero-img"
      />
      <!-- Subtle dark vignette at the bottom edge — keeps the image grounded -->
      <div class="vignette" aria-hidden="true"></div>
    </div>

    <!-- ── Post header (narrow prose column) ─────────────────── -->
    <div class="container">
      <header class="post-header">
        <div class="tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <div class="meta">
          <span class="author">{author}</span>
          <span class="dot" aria-hidden="true">·</span>
          <time datetime={publishDate.toISOString()}>{date}</time>
        </div>
      </header>
    </div>

    <!-- ── Cloudinary showcase (wider column for visual impact) ─ -->
    <div class="showcase-wrap">
      <CloudinaryShowcase publicId={coverImage} alt={coverAlt} />
    </div>

    <!-- ── Article prose (narrow prose column) ───────────────── -->
    <div class="container">
      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <a href="/blog" class="back">&larr; Back to all posts</a>
      </footer>
    </div>

  </article>
</Layout>

<style>
  article {
    width: 100%;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    width: 100%;
    height: clamp(320px, 52vw, 600px);
    overflow: hidden;
  }

  :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Dark cinematic vignette — grounds the image without bleeding to white */
  .vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, transparent 55%, rgb(0 0 0 / 0.35) 100%),
      linear-gradient(to right, rgb(0 0 0 / 0.08) 0%, transparent 20%, transparent 80%, rgb(0 0 0 / 0.08) 100%);
    pointer-events: none;
  }

  /* ── Containers ── */
  .container {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Wider than prose so showcase images have room */
  .showcase-wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Post header ── */
  .post-header {
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: var(--accent-light);
    color: var(--accent);
  }

  .post-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .author {
    font-weight: 500;
  }

  .dot {
    opacity: 0.35;
  }

  /* ── Prose ── */
  .prose :global(h2) {
    font-size: 1.625rem;
    margin-top: 3rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 2.25rem;
    margin-bottom: 0.625rem;
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: 0.375rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
  }

  .prose :global(th) {
    background: var(--bg-secondary);
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
  }

  .prose :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    border-radius: var(--radius-md);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* ── Footer ── */
  .post-footer {
    margin-top: 4rem;
    padding: 2rem 0 5rem;
    border-top: 1px solid var(--border);
  }

  .back {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }
</style>
