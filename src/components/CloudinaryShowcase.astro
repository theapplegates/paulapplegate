---
/**
 * CloudinaryShowcase
 *
 * Takes a single Cloudinary public ID and renders three side-by-side
 * variants — each with a different transformation applied.
 * Drop this inside any blog post layout to let readers see the power
 * of Cloudinary without leaving the article.
 */
import CloudinaryImage from './CloudinaryImage.astro';

interface Props {
  publicId: string;
  cloudName?: string;
  alt: string;
}

const { publicId, cloudName, alt } = Astro.props;

const variants = [
  {
    code: 'JXL → AVIF → WebP',
    label: 'Responsive formats',
    note: 'JXL first, with AVIF and WebP fallbacks',
    options: { width: 640, height: 420, crop: 'fill' as const },
    featured: true,
  },
  {
    code: 'e_grayscale',
    label: 'Greyscale',
    note: 'One param — no Photoshop needed',
    options: { width: 640, height: 420, crop: 'fill' as const, grayscale: true },
    featured: false,
  },
  {
    code: 'e_blur:500',
    label: 'Soft blur',
    note: 'Ideal for hero backdrops',
    options: { width: 640, height: 420, crop: 'fill' as const, blur: 500 },
    featured: false,
  },
];
---

<aside class="showcase" aria-label="Cloudinary transformation examples">
  <div class="showcase-head">
    <span class="badge">Cloudinary in action</span>
    <p>The same image, three transformations — all delivered via URL parameters.</p>
  </div>

  <div class="grid">
    {variants.map(({ code, label, note, options, featured }) => (
      <div class:list={['card', { featured }]}>
        <div class="img-wrap">
          <CloudinaryImage
            publicId={publicId}
            cloudName={cloudName}
            {...options}
            sizes="(max-width: 620px) calc(100vw - 6.5rem), (max-width: 1040px) calc((100vw - 8.25rem) / 3), 303px"
            alt={`${alt} — ${label}`}
            width={640}
            height={420}
            loading="lazy"
          />
        </div>
        <div class="info">
          <code class="code">{code}</code>
          <span class="label">{label}</span>
          <span class="note">{note}</span>
        </div>
      </div>
    ))}
  </div>
</aside>

<style>
  .showcase {
    margin: 3rem 0;
    padding: 1.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .showcase-head {
    margin-bottom: 1.25rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    background: var(--accent-light);
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .showcase-head p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .card.featured {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  .img-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .img-wrap :global(picture),
  .img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .info {
    padding: 0.75rem 0.875rem;
    display: grid;
    gap: 0.2rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-light);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    width: fit-content;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .note {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
