---
import CloudinaryImage from './CloudinaryImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate, coverImage, coverCloudName, coverAlt, tags } = post.data;

const date = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  <a href={`/blog/${post.id}`} class="card-link" aria-label={title}>
    <div class="card-image">
      <CloudinaryImage
        publicId={coverImage}
        cloudName={coverCloudName}
        alt={coverAlt}
        width={800}
        height={450}
        sizes="(max-width: 679px) calc(100vw - 3rem), (max-width: 1011px) calc((100vw - 5rem) / 2), (max-width: 1200px) calc((100vw - 7rem) / 3), 363px"
        crop="fill"
        gravity="auto"
        class="card-img"
      />
    </div>

    <div class="card-body">
      <div class="tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>
      <div class="card-bottom"><time datetime={publishDate.toISOString()} class="card-date">{date}</time><span class="card-arrow" aria-hidden="true">↗</span></div>
    </div>
  </a>
</article>

<style>
  .card {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #fffdf7;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .card:hover, .card:focus-within {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    animation: card-jiggle 650ms ease both;
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-image {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .card:hover .card-img {
    transform: scale(1.04);
  }

  .card-body {
    padding: 1.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: var(--accent-light);
    color: var(--accent);
  }

  .card-title {
    font-size: 1.1875rem;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .card-arrow { color: var(--accent); font-size: 1.4rem; }
  @keyframes card-jiggle { 0%,100% { transform: translateY(-3px) rotate(0); } 25% { transform: translateY(-4px) rotate(-.7deg); } 65% { transform: translateY(-3px) rotate(.5deg); } }
</style>
