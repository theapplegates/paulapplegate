---
const pathname = Astro.url.pathname;
---

<header class="header">
  <nav class="nav" aria-label="Main navigation">
	<a href="/" class="logo" aria-label="Paul Applegate — home"><span class="mark" aria-hidden="true">pa.</span><span>Paul Applegate<span class="tagline">A CABINET OF CURIOSITIES</span></span></a>
	<ul class="nav-links">
	  <li><a href="/jxlsetup" aria-current={pathname.startsWith('/jxlsetup') ? 'page' : undefined}>JXL Setup</a></li>
	  <li><a href="/blog" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>Field notes</a></li>
	  <li><a href="/#observatory">The observatory <span aria-hidden="true">↗</span></a></li>
	  <li><a href="/public-key" aria-current={pathname.startsWith('/public-key') ? 'page' : undefined}>Public key</a></li>
	  <li class="search-slot">
		<div id="search">
		  <form class="orama-form" role="search">
			<input class="orama-input" type="search" placeholder="Search…" aria-label="Search the site" autocomplete="off">
		  </form>
		  <div class="orama-drawer" hidden>
			<p class="orama-status" role="status" aria-live="polite"></p>
			<ol class="orama-results"></ol>
		  </div>
		</div>
	  </li>
	</ul>
  </nav>

  <script>
	import { create, insert, search as oramaSearch } from '@orama/orama';

	const root = document.getElementById('search');
	const form = root.querySelector('.orama-form');
	const input = root.querySelector('.orama-input');
	const drawer = root.querySelector('.orama-drawer');
	const status = root.querySelector('.orama-status');
	const list = root.querySelector('.orama-results');

	// Load search-index.json and build the Orama database — once, on first use
	let dbPromise = null;
	function loadDb() {
	  if (!dbPromise) {
		dbPromise = (async () => {
		  const res = await fetch('/search-index.json');
		  if (!res.ok) throw new Error('search-index.json missing');
		  const docs = await res.json();
		  const db = await create({
			schema: { title: 'string', description: 'string', content: 'string', url: 'string' },
		  });
		  for (const doc of docs) await insert(db, doc);
		  return db;
		})().catch((err) => {
		  dbPromise = null; // let a later focus retry
		  status.textContent = 'Search index not found — run "npm run build" at least once.';
		  drawer.hidden = false;
		  console.error('[orama]', err);
		});
	  }
	  return dbPromise;
	}

	// ---- small helpers -------------------------------------------------------
	const esc = (s) => s.replace(/[&<>"']/g, (c) => `&${{'&':'amp','<':'lt','>':'gt','"':'quot',"'":'#39'}[c]};`);

	// Drop the "| Paul Applegate" / "— Paul Applegate" site suffix from titles
	const cleanTitle = (t) => t.replace(/\s*[|–—-]\s*Paul Applegate\s*$/, '').trim() || t;

	// Edit distance, for picking the corrected word to suggest
	function lev(a, b) {
	  if (Math.abs(a.length - b.length) > 2) return 3;
	  const m = a.length, n = b.length;
	  const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
	  for (let i = 0; i <= m; i++) dp[i][0] = i;
	  for (let j = 0; j <= n; j++) dp[0][j] = j;
	  for (let i = 1; i <= m; i++)
		for (let j = 1; j <= n; j++)
		  dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
	  return dp[m][n];
	}

	// Orama reports WHERE matches are: hit.positions = { property: { term: [{start, length}] } }.
	// Flatten + merge those ranges so overlapping matches become one highlight.
	function flattenRanges(posForProp) {
	  const all = [];
	  if (posForProp) {
		for (const ranges of Object.values(posForProp))
		  for (const r of ranges) all.push({ start: r.start, end: r.start + r.length });
	  }
	  all.sort((a, b) => a.start - b.start);
	  const merged = [];
	  for (const r of all) {
		const last = merged[merged.length - 1];
		if (last && r.start <= last.end) last.end = Math.max(last.end, r.end);
		else merged.push({ ...r });
	  }
	  return merged;
	}

	// Render text[winStart:winEnd] as safe HTML with matches wrapped in <mark>
	function highlightWindow(text, ranges, winStart, winEnd) {
	  let html = '', cursor = winStart;
	  for (const r of ranges) {
		if (r.end <= winStart) continue;
		if (r.start >= winEnd) break;
		const s = Math.max(r.start, winStart), e = Math.min(r.end, winEnd);
		if (s > cursor) html += esc(text.slice(cursor, s));
		html += `<mark>${esc(text.slice(s, e))}</mark>`;
		cursor = e;
	  }
	  return html + esc(text.slice(cursor, winEnd));
	}

	// ~200-char snippet centered on the first match
	function excerpt(text, ranges) {
	  if (!text) return '';
	  if (!ranges.length) {
		const end = Math.min(180, text.length);
		return esc(text.slice(0, end)) + (text.length > end ? '…' : '');
	  }
	  const start = Math.max(0, ranges[0].start - 60);
	  const end = Math.min(text.length, ranges[0].end + 140);
	  return (start > 0 ? '…' : '') + highlightWindow(text, ranges, start, end) + (end < text.length ? '…' : '');
	}

	// If a typo still produced results, figure out the corrected word(s) to show
	function correctedQuery(query, hits) {
	  const matched = new Set();
	  for (const h of hits)
		for (const terms of Object.values(h.positions || {}))
		  for (const term of Object.keys(terms)) matched.add(term.toLowerCase());
	  let changed = false;
	  const words = query.trim().split(/\s+/).map((w) => {
		const lw = w.toLowerCase();
		if (lw.length < 3 || matched.has(lw)) return w;
		let best = null, bestDist = 3;
		for (const t of matched) {
		  const d = lev(lw, t);
		  if (d > 0 && d < bestDist) { best = t; bestDist = d; }
		}
		if (best) { changed = true; return best; }
		return w;
	  });
	  return changed ? words.join(' ') : null;
	}

	// ---- search + render -----------------------------------------------------
	function render(query, res) {
	  const hits = res.hits;
	  if (!hits.length) {
		status.innerHTML = `No results for <strong>${esc(query)}</strong>`;
		list.innerHTML = '';
		drawer.hidden = false;
		return;
	  }
	  const fixed = correctedQuery(query, hits);
	  status.innerHTML = fixed
		? `Showing results for <strong>${esc(fixed)}</strong>`
		: `${res.count} result${res.count === 1 ? '' : 's'}`;
	  list.innerHTML = hits.map((h) => {
		const d = h.document;
		const pos = h.positions || {};
		const title = cleanTitle(d.title || d.url);
		const titleHtml = highlightWindow(title, flattenRanges(pos.title), 0, title.length);
		const bodyHtml = flattenRanges(pos.content).length
		  ? excerpt(d.content, flattenRanges(pos.content))
		  : flattenRanges(pos.description).length
			? excerpt(d.description, flattenRanges(pos.description))
			: excerpt(d.description || d.content, []);
		return `<li><a href="${esc(d.url)}">` +
		  `<span class="orama-title">${titleHtml}</span>` +
		  `<span class="orama-url">${esc(d.url)}</span>` +
		  `<span class="orama-excerpt">${bodyHtml}</span>` +
		  `</a></li>`;
	  }).join('');
	  drawer.hidden = false;
	}

	let timer = null;
	let lastQuery = '';
	async function runSearch() {
	  const q = input.value.trim();
	  lastQuery = q;
	  if (!q) { drawer.hidden = true; list.innerHTML = ''; return; }
	  const db = await loadDb();
	  if (!db || q !== lastQuery) return;
	  const res = await oramaSearch(db, {
		term: q,
		properties: ['title', 'description', 'content'],
		tolerance: 1, // allow one typo per word
		limit: 10,
	  });
	  if (q !== lastQuery) return; // user kept typing meanwhile
	  // title matches first, then by relevance
	  res.hits.sort((a, b) => ((b.positions?.title ? 1 : 0) - (a.positions?.title ? 1 : 0)) || b.score - a.score);
	  render(q, res);
	}

	// ---- events --------------------------------------------------------------
	input.addEventListener('focus', () => {
	  loadDb(); // warm up the database on first visit
	  if (input.value.trim()) runSearch();
	});
	input.addEventListener('input', () => {
	  clearTimeout(timer);
	  timer = setTimeout(runSearch, 150);
	});
	input.addEventListener('keydown', (e) => {
	  if (e.key === 'Escape') { input.value = ''; drawer.hidden = true; input.blur(); }
	  if (e.key === 'Enter') { e.preventDefault(); list.querySelector('a')?.click(); }
	});
	form.addEventListener('submit', (e) => e.preventDefault());
	document.addEventListener('click', (e) => { if (!root.contains(e.target)) drawer.hidden = true; });
  </script>
</header>

<style>
.header{position:sticky;top:0;z-index:100;background:rgb(247 245 238 / .96);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav{max-width:var(--max-width);margin:auto;padding:1.1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;gap:2rem}
.logo{display:flex;gap:.8rem;align-items:center;font-size:1rem;font-weight:600;color:var(--text);text-decoration:none;line-height:1.4}.mark{border:1px solid var(--text);border-radius:50%;width:42px;height:42px;display:grid;place-items:center;font-size:1.25rem;font-style:italic}
.tagline{display:block;font-size:.56rem;letter-spacing:.17em;color:var(--text-muted);margin-top:.2rem}.nav-links{display:flex;gap:1.8rem;list-style:none;font-size:.8rem;margin:0;padding:0;align-items:center}.nav-links a{color:var(--text);text-decoration:none;padding:.6rem 0}.nav-links a:hover,.nav-links a[aria-current]{color:var(--accent);text-decoration:underline;text-underline-offset:5px}
.search-slot{display:flex;align-items:center;margin-top:-4px}.search-slot #search{min-width:200px}
@media(max-width:600px){.nav{flex-wrap:wrap;gap:.5rem;padding:.9rem 1.25rem}.nav-links{width:100%;flex-wrap:wrap;justify-content:space-between;gap:.3rem .8rem;font-size:.78rem}.nav-links a{white-space:nowrap;padding:.35rem 0}.search-slot{width:100%;margin-top:.4rem}.search-slot #search{width:100%}.tagline{font-size:.55rem;letter-spacing:.12em}}
</style>
