---
const pathname = Astro.url.pathname;
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo">
      astro<span>blog</span>
    </a>
    <ul class="nav-links">
      <li>
        <a
          href="/blog"
          class:list={['nav-link', { active: pathname.startsWith('/blog') }]}
        >
          Blog
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--text);
  }

  .logo span {
    color: var(--accent);
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
    text-decoration: none;
  }
</style>
