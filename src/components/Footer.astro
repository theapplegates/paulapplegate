---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <p>
      Built with
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      &amp;
      <a href="https://cloudinary.com" target="_blank" rel="noopener">Cloudinary</a>
    </p>
    <p class="copy">&copy; {year} CloudCanvas</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: center;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    align-items: center;
  }

  .footer a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .copy {
    opacity: 0.6;
  }
</style>
