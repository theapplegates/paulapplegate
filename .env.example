# Cloudinary credentials for `npm run cloudinary:breakpoints` (scripts/cloudinary-breakpoints.mjs).
# Copy to `.env.local` and fill in. Only the cloud name is public; the key and
# secret are used by the uploader script alone — never by the build or browser.
# The uploader loads `.env`, then `.env.local`; terminal environment values win.
PUBLIC_CLOUDINARY_CLOUD_NAME=paulapplegate-com
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
